<script type="text/javascript" src="https://www.tekhelet.com/wp-content/themes/Divi/includes/builder-5/visual-builder/build/script-library-multi-view.js?ver=5.0.0-public-beta.5.2" id="divi-script-library-multi-view-js"></script>
    <script>
    (function($){
        jQuery(function($){
            window.dataLayer = window.dataLayer || [];

            // helper to extract product info from DOM context
            function extractItemFromElement($el) {
                var $prod = $el.closest('.product');
                var id = $prod.data('product_id') || $el.data('product_id') || $el.data('product-id') || null;
                var name = $prod.find('.woocommerce-loop-product__title').text() || $('.product_title').text() || '';
                var priceText = $prod.find('.price').first().text() || '';
                var price = null;
                if (priceText) {
                    price = parseFloat(priceText.replace(/[^0-9\.\,-]/g, '').replace(',','.')) || null;
                }
                return {
                    item_id: id,
                    item_name: name,
                    price: price,
                    quantity: 1
                };
            }

            // catch add to cart button clicks
            $(document.body).on('click', '.add_to_cart_button, button.single_add_to_cart_button, form.cart .single_add_to_cart_button', function(e){
                try {
                    var itm = extractItemFromElement($(this));
                    if (!itm.item_id) return;
                    dataLayer.push({ ecommerce: null });
                    dataLayer.push({
                        event: 'add_to_cart',
                        ecommerce: {
                            currency: "USD",
                            items: [ itm ]
                        }
                    });
                } catch(e) {}
            });

            // For AJAX add_to_cart hooks (Woo core fires 'added_to_cart' event)
            $(document.body).on('added_to_cart', function(event, fragments, cart_hash, $btn){
                try {
                    var $btnEl = $btn || $(this);
                    var itm = extractItemFromElement($btnEl);
                    if (!itm.item_id) return;
                    dataLayer.push({ ecommerce: null });
                    dataLayer.push({
                        event: 'add_to_cart',
                        ecommerce: {
                            currency: "USD",
                            items: [ itm ]
                        }
                    });
                } catch(e) {}
            });
        });
    })(jQuery);
    </script>
    </body>
</html>
