<style class="et-vb-global-data et-vb-global-fonts">:root{--et_global_heading_font: 'Roboto';--et_global_body_font: 'Roboto';--et_global_heading_font_weight: 500;--et_global_body_font_weight: 500;}</style><style type="text/css" media="screen"></style><script>(function($){
    function initVariationImageFix(){
        var $gallery = $('.woocommerce-product-gallery');
        var $form = $('form.variations_form');

        if(!$gallery.length || !$form.length) return;

        var $mainSlide = $gallery.find('.woocommerce-product-gallery__image').first().find('img');
        if(!$mainSlide.length) return;

        var originalImage = {
            src: $mainSlide.attr('src'),
            srcset: $mainSlide.attr('srcset') || '',
            alt: $mainSlide.attr('alt') || '',
            large: $mainSlide.attr('data-large_image'),
            linkHref: $mainSlide.closest('a').attr('href'),
            zoomSrc: $gallery.find('.zoomImg').first().attr('src')
        };

        $form
            .off('found_variation.fixImage')
            .on('found_variation.fixImage', function(e, variation){
                if(!variation || !variation.image || !variation.image.src) return;

                var $img = $gallery.find('.woocommerce-product-gallery__image.flex-active-slide img');
                if(!$img.length){
                    $img = $gallery.find('.woocommerce-product-gallery__image').first().find('img');
                }

                $img
                    .attr('src', variation.image.src)
                    .attr('srcset', variation.image.srcset || '')
                    .attr('alt', variation.image.alt || '')
                    .attr('data-large_image', variation.image.full_src);

                $img.closest('a').attr('href', variation.image.full_src);
                $gallery.find('.zoomImg').attr('src', variation.image.full_src);
            });

        $form
            .off('reset_data.fixImage')
            .on('reset_data.fixImage', function(){
                var slider = $gallery.data('flexslider');
                if(slider){
                    slider.flexAnimate(0);
                }

                var $img = $gallery.find('.woocommerce-product-gallery__image').first().find('img');

                $img
                    .attr('src', originalImage.src)
                    .attr('srcset', originalImage.srcset)
                    .attr('alt', originalImage.alt)
                    .attr('data-large_image', originalImage.large);

                $img.closest('a').attr('href', originalImage.linkHref);
                $gallery.find('.zoomImg').attr('src', originalImage.zoomSrc);
            });
    }

    // Run after everything (important for cached pages)
    $(window).on('load', function(){
         setTimeout(initVariationImageFix, 300);
     });

})(jQuery);

</script>	<script type='text/javascript'>
