.DS_Store
resources/_gen/
_archive/

# Licensed source maps (e.g. LDS Bible Maps used by permission) — do NOT commit/publish raw
_source-maps/
*.backup-*

# Cloudflare wrangler local cache (contains account creds)
.wrangler/

# Claude Code worktrees & session checkpoints — never track these.
# They had been committed as stray gitlinks (submodule refs) with no
# .gitmodules entry, which made every `git clone --recurse-submodules`
# fail — that is what broke Cloudflare Pages builds at the clone step.
.claude/worktrees/
.session-checkpoints/

# Lexicon backups are working artefacts and must NEVER be published. static/ is served
# directly, so a .bak at /data/ is publicly fetchable — and this one carried the 28
# CORRUPT theophoric entries the repair had just fixed, i.e. a public copy of the
# divine name resolving to a man. Written by verification/repair_theophoric_originals.py.
static/data/*.bak-*
static/data/*.json.bak*
